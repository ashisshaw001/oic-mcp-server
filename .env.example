# Server settings. OIC credentials go in the INI file (see oic.ini.example), not here.
# Unknown keys are ignored, so this file can be shared with other tooling.

# --- where to listen ---
MCP_HOST=127.0.0.1
MCP_PORT=8085

# --- who may call it ---
# Comma-separated Bearer tokens (32+ random chars). List two while rotating.
# Each token is also a tenant boundary: uploads and session state made with one token are
# invisible to the others, so give each backend/tenant its own.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKENS=
# Local development only; refused unless MCP_HOST is a loopback address.
MCP_AUTH_DISABLED=false
# Browser-based MCP clients send an Origin header; list the ones you trust.
MCP_ALLOWED_ORIGINS=
# Optional Host allowlist, e.g. mcp.example.com  (host:* allows any port)
MCP_ALLOWED_HOSTS=

# --- OIC environments ---
# Server-side INI shared by all callers (e.g. for Fusion AI Agent Studio).
OIC_CONFIG_FILE=oic.ini
# Allow per-user uploads via POST /config (kept in memory, expire after idle TTL).
# Set false if everyone uses the server-side file (e.g. an Agent Studio-only deployment).
OIC_CONFIG_UPLOADS_ENABLED=true
OIC_UPLOAD_TTL_SECS=43200
OIC_MAX_UPLOADS_PER_TOKEN=20
OIC_MAX_ENVIRONMENTS_PER_UPLOAD=50
# Uploaded url/token_url hosts must end with one of these (stops uploads pointing the server
# at internal hosts). Add your custom domain if you use one. Empty = allow any host.
OIC_UPLOAD_ALLOWED_HOST_SUFFIXES=.ocp.oraclecloud.com,.identity.oraclecloud.com

# --- MCP transport ---
# true = no Mcp-Session-Id (simplest behind a load balancer; pass `environment` per call)
MCP_STATELESS=false
MCP_JSON_RESPONSE=true
MCP_SESSION_IDLE_TIMEOUT_SECS=1800

# --- outbound calls to OIC ---
HTTP_TIMEOUT_SECS=30
HTTP_MAX_RETRIES=2
CATALOGUE_TTL_SECS=120
MAX_RESPONSE_BYTES=20971520
# Redirects keep the bearer token only for the same host and the same region's shared
# design host (design.integration.<region>.ocp.oraclecloud.com). Add suffixes here only if
# your OIC redirects somewhere else legitimate.
OIC_REDIRECT_ALLOWED_SUFFIXES=

# --- output & logging ---
MAX_RESULT_CHARS=60000
LOG_LEVEL=INFO
# MCP_LOG_FILE=mcp_server.log
